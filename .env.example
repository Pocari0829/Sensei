# =============================================================
# 환경변수 예시 파일
#
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
#   Windows :  copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
# =============================================================

# --- Google Gemini (필수) ---------------------------------
# 이 값이 비어 있으면 서버가 아예 켜지지 않습니다.
#   ValueError: No API key was provided.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 모델. 코드에 박지 않고 여기서 관리합니다.
# (예전 설정) HAKU_MODEL=gemini-3-flash-preview
#
# 무료 사용량은 "모델마다 따로" 계산됩니다.
# 그래서 부분마다 다른 모델을 쓰면 하루에 쓸 수 있는 양이 늘어납니다.
# 하쿠 꼬리질문: 한도가 넉넉한 가벼운 모델. 정오 판별과 같은 모델이라 하루 한도를 같이 씁니다.
# (예전 설정) HAKU_MODEL=gemini-3.6-flash  <- 말투는 더 자연스럽지만 하루 한도가 적었음
HAKU_MODEL=gemini-3.5-flash-lite
# 정오 판별: 메시지마다 불리므로 가장 빠른 것 (약 1초)
CHECK_MODEL=gemini-3.5-flash-lite
# 문제 생성: 가벼운(lite) 모델. 2~3초로 빠르고, 하쿠/정오 판별과 다른 모델이라 한도를 따로 씁니다.
# 이 줄이 없으면 CHECK_MODEL 을 같이 씁니다.
# (예전 설정) QUIZ_MODEL=gemini-3.8-flash
QUIZ_MODEL=gemini-3.1-flash-lite
# 문제 유형 고르기: 문제를 만들기 전에 빈칸 주관식 / 객관식 중 어느 쪽으로 낼지 고릅니다. (문제는 QUIZ_MODEL 이 만듭니다)
# 이 줄이 없으면 gemini-3.1-flash-lite 를 씁니다. 실패하면(혼잡 등) 이미 낸 문제 중 덜 나온 유형으로 정합니다.
QUIZ_TYPE_MODEL=gemini-3.1-flash-lite
# 대답 수준 판단: 사용자가 메시지를 보낼 때마다 어느 학교급 수준의 설명인지(레벨 1~5) 판단합니다.
# 하쿠의 대답과 따로 돌지만, 판단 결과는 채팅 화면이 저장하므로 화면을 옮기기 전에 끝나야 기록됩니다. 그래서 빠른 모델을 씁니다.
# (예전 설정) LEVEL_MODEL=gemini-3.1-flash-lite  <- 한도는 따로 쓰지만 가끔 1분 넘게 걸려서, 그사이 화면을 옮기면 기록이 사라졌음
# 하쿠/정오 판별과 같은 모델이라 하루 한도를 같이 씁니다. 이 줄이 없으면 gemini-3.5-flash-lite 를 씁니다.
LEVEL_MODEL=gemini-3.5-flash-lite


# --- Flask (선택) -----------------------------------------
# 없어도 기본값으로 동작합니다.
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=5000


# --- Supabase (로그인 / DB) --------------------------------
# serve_frontend.py 가 이 두 값으로 프론트의 config.js 를 만들어 줍니다.
# 대시보드 → Project Settings → API Keys 에서 확인합니다.
#   SUPABASE_URL      = https://<프로젝트 ref>.supabase.co
#   SUPABASE_ANON_KEY = Publishable key (sb_publishable_...). 브라우저에 보여도 되는 키입니다.
# Secret key(sb_secret_...) 는 이 두 칸에 넣지 마세요. DB 를 마음대로 다룰 수 있는 키입니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google 로그인 -----------------------------------------
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션) 의 "클라이언트 ID".
#   (...apps.googleusercontent.com 으로 끝나는 값. 브라우저에 보여도 되는 값입니다)
# 같은 값을 Supabase → Authentication → Sign In / Providers → Google 의 Client IDs 에도 넣어야 합니다.
GOOGLE_CLIENT_ID=
