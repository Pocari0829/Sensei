# =============================================================
# 환경변수 예시 파일
#
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
#   Windows :  copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
# =============================================================

# --- Google Gemini (필수) ---------------------------------
# 이 값이 비어 있으면 서버가 아예 켜지지 않습니다.
#   ValueError: No API key was provided.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 모델. 코드에 박지 않고 여기서 관리합니다.
HAKU_MODEL=gemini-3-flash-preview


# --- Flask (선택) -----------------------------------------
# 없어도 기본값으로 동작합니다.
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=5000


# --- Supabase (아직 미사용) --------------------------------
# 코드에서 아직 읽지 않습니다. DB 연동 시 사용 예정.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
