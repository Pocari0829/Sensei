# =============================================================
# 환경변수 예시 파일
#
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
#   Windows :  copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
# =============================================================

# --- Google Gemini (필수) ---------------------------------
# 이 값이 비어 있으면 서버가 아예 켜지지 않습니다.
#   ValueError: No API key was provided.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 모델. 코드에 박지 않고 여기서 관리합니다.
# (예전 설정) HAKU_MODEL=gemini-3-flash-preview
#
# 무료 사용량은 "모델마다 따로" 계산됩니다.
# 그래서 부분마다 다른 모델을 쓰면 하루에 쓸 수 있는 양이 늘어납니다.
# 하쿠 꼬리질문: 한도가 넉넉한 가벼운 모델. 정오 판별과 같은 모델이라 하루 한도를 같이 씁니다.
# (예전 설정) HAKU_MODEL=gemini-3.6-flash  <- 말투는 더 자연스럽지만 하루 한도가 적었음
# 쉼표로 적은 순서대로 시도합니다: 3.5-flash-lite 가 분당 한도에 걸리면 3.1-flash-lite 로 넘어갑니다. (느리지만 대답은 함)
# 맨 뒤 gemma-4-26b-a4b-it 는 앞의 Gemini 모델을 다 쓰거나 실패했을 때만 쓰는 예비 모델입니다. (아래 설정도 모두 같음)
# 3.1-flash-lite-preview / 3-flash-preview 는 다른 곳에서 안 쓰는 모델이라 한도를 더해 줍니다.
# 3.5-flash / 3.6-flash 는 하루 20번뿐이고 문제 생성과 한도를 같이 쓰므로 gemma 바로 앞에 둡니다.
# (3.7-flash / 3.8-flash 는 지금 설정으로는 시간 초과가 나서 넣지 않았습니다)
HAKU_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash,gemma-4-26b-a4b-it
# 정오 판별: 메시지마다 불리므로 가장 빠른 것 (약 1초)
# 쉼표로 적은 순서대로 시도: 3.5-flash-lite 가 분당 한도(15번)에 걸리면 3.1-flash-lite 로 넘어간습니다. (느리지만 판별은 됨)
CHECK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash,gemma-4-26b-a4b-it
# 문제 생성: 쉼표로 적은 순서대로 시도합니다. 사용량 초과·혼잡·시간 초과면 다음 모델로 넘어갑니다.
# 여러 개를 적으면 맨 뒤 모델은 마지막 수단입니다. 이 모델로 만들면 퀴즈 화면에 "오늘 사용량이 많아서…" 안내가 뜹니다.
# 이 줄이 없으면 CHECK_MODEL 을 같이 씁니다.
# 3.5-flash 와 3.6-flash 는 하루 무료 한도가 20번뿐이라 금방 찬다. 그때는 3.5-flash-lite 가 대신 만든다.
QUIZ_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemma-4-26b-a4b-it
# 빈칸 주관식 채점: 3.5-flash 로 채점하다가 한도가 다 되면(또는 혼잡하면) 3.5-flash-lite → 3.1-flash-lite → gemma 로 넘어갑니다.
GRADE_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemma-4-26b-a4b-it
# 문제 유형 고르기: 문제를 만들기 전에 빈칸 주관식 / 객관식 중 어느 쪽으로 낼지 고릅니다. (문제는 QUIZ_MODEL 이 만듭니다)
# 이 줄이 없으면 gemini-3.1-flash-lite 를 씁니다. 실패하면(혼잡 등) 이미 낸 문제 중 덜 나온 유형으로 정합니다.
QUIZ_TYPE_MODEL=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemma-4-26b-a4b-it
# 대답 수준 판단: 사용자가 메시지를 보낼 때마다 어느 학교급 수준의 설명인지(레벨 1~5) 판단합니다.
# 하쿠의 대답과 따로 돌지만, 판단 결과는 채팅 화면이 저장하므로 화면을 옮기기 전에 끝나야 기록됩니다. 그래서 빠른 모델을 씁니다.
# (예전 설정) LEVEL_MODEL=gemini-3.1-flash-lite  <- 한도는 따로 쓰지만 가끔 1분 넘게 걸려서, 그사이 화면을 옮기면 기록이 사라졌음
# 하쿠/정오 판별과 같은 모델이라 하루 한도를 같이 씁니다. 이 줄이 없으면 gemini-3.5-flash-lite 를 씁니다.
LEVEL_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemma-4-26b-a4b-it


# --- Flask (선택) -----------------------------------------
# 없어도 기본값으로 동작합니다.
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=5000


# --- Supabase (로그인 / DB) --------------------------------
# serve_frontend.py 가 이 두 값으로 프론트의 config.js 를 만들어 줍니다.
# 대시보드 → Project Settings → API Keys 에서 확인합니다.
#   SUPABASE_URL      = https://<프로젝트 ref>.supabase.co
#   SUPABASE_ANON_KEY = Publishable key (sb_publishable_...). 브라우저에 보여도 되는 키입니다.
# Secret key(sb_secret_...) 는 이 두 칸에 넣지 마세요. DB 를 마음대로 다룰 수 있는 키입니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google 로그인 -----------------------------------------
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션) 의 "클라이언트 ID".
#   (...apps.googleusercontent.com 으로 끝나는 값. 브라우저에 보여도 되는 값입니다)
# 같은 값을 Supabase → Authentication → Sign In / Providers → Google 의 Client IDs 에도 넣어야 합니다.
GOOGLE_CLIENT_ID=
